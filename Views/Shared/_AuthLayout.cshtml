@* Layout de pantalla completa para las páginas de cuenta (inicio de sesión y registro).
   Sin cabecera ni pie: la página ocupa toda la ventana. Usa los mismos estilos base que _Layout. *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Alerta Vecinal: reporta, participa y mejora tu comunidad." />
    <meta name="theme-color" content="#0b1220" />
    <title>@ViewData["Title"] · Alerta Vecinal</title>

    <partial name="_TemaScript" />

    <link rel="icon" href="~/favicon.ico" sizes="48x48" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body class="auth-pantalla">
    <a class="skip-link" href="#contenido">Saltar al formulario</a>

    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
