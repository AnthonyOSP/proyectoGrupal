@{
    // Acción actual, para resaltar el enlace activo del menú.
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(params string[] acciones) => acciones.Contains(accion) ? "active" : "";
    string? Actual(params string[] acciones) => acciones.Contains(accion) ? "page" : null;

    // El menú solo refleja la sesión; los permisos reales se comprueban en los controladores con [Authorize].
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdministrador = autenticado && User.IsInRole(RoleNames.Administrador);

    // Al iniciar sesión desde cualquier página, se vuelve a esa misma página.
    var enCuenta = ViewContext.RouteData.Values["controller"]?.ToString() == "Account";
    var paginaActual = enCuenta || Context.Request.Path == "/" ? null : $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Alerta Vecinal: reporta, participa y mejora tu comunidad." />
    <meta name="theme-color" content="#1d4ed8" />
    <title>@ViewData["Title"] · Alerta Vecinal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Navegación principal">
            <div class="container">
                <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Alerta Vecinal, ir al inicio">
                    <span class="brand__mark" aria-hidden="true">@Iconos.Svg("megaphone", 20)</span>
                    <span class="brand__text">Alerta<span>Vecinal</span></span>
                </a>

                <button class="navbar-toggler menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    @Iconos.Svg("menu", 24)
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav mx-lg-auto">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Index")" aria-current="@Actual("Index")" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Incidencias", "Detalle")" aria-current="@Actual("Incidencias")" asp-controller="Home" asp-action="Incidencias">Incidencias</a>
                        </li>
                        @if (autenticado)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("MisIncidencias")" aria-current="@Actual("MisIncidencias")" asp-controller="Home" asp-action="MisIncidencias">Mis incidencias</a>
                            </li>
                        }
                        @if (esAdministrador)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Panel administrativo</a>
                            </li>
                        }
                    </ul>
                    <div class="nav-acciones">
                        <a class="btn btn-av-primary nav-cta" aria-current="@Actual("Reportar")" asp-controller="Home" asp-action="Reportar">
                            @Iconos.Svg("plus", 18) Reportar ahora
                        </a>
                        @if (autenticado)
                        {
                            @* Con el enlace "Panel administrativo" el menú tiene más opciones: el correo se muestra solo como ícono en escritorio. *@
                            <div class="nav-usuario @(esAdministrador ? "nav-usuario--compacto" : "")">
                                <span class="nav-usuario__correo" title="@User.Identity!.Name">
                                    @Iconos.Svg("user", 18)
                                    <span><span class="visually-hidden">Sesión iniciada como </span>@User.Identity!.Name</span>
                                </span>
                                @* Cerrar sesión solo por POST: el tag helper <form> agrega el token antiforgery. *@
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-av-ghost nav-salir" title="Cerrar sesión">
                                        @Iconos.Svg("log-out", 18) <span class="nav-salir__texto">Cerrar sesión</span>
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-av-secondary nav-entrar" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@paginaActual">
                                @Iconos.Svg("log-in", 18) Iniciar sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__grid">
                <div>
                    <a class="brand brand--footer" asp-controller="Home" asp-action="Index">
                        <span class="brand__mark" aria-hidden="true">@Iconos.Svg("megaphone", 18)</span>
                        <span class="brand__text">Alerta<span>Vecinal</span></span>
                    </a>
                    <p class="site-footer__lema">Una plataforma para participar y ayudar a mejorar nuestra comunidad.</p>
                </div>
                <nav aria-label="Enlaces del pie de página">
                    <h2 class="site-footer__titulo">Navegación</h2>
                    <ul class="site-footer__links">
                        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a asp-controller="Home" asp-action="Reportar">Reportar incidencia</a></li>
                        <li><a asp-controller="Home" asp-action="Incidencias">Incidencias</a></li>
                    </ul>
                </nav>
            </div>
            <div class="site-footer__base">
                <span>&copy; @DateTime.Now.Year Alerta Vecinal</span>
                <span class="site-footer__tag">Proyecto académico</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
