<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programa de consola que entrena el clasificador de categorías de incidencias (multiclase).
       Se ejecuta a mano cuando cambian los datos de entrenamiento (ver README.md de esta carpeta).
       No es parte de la aplicación web: proyectoGrupal.csproj excluye la carpeta ML/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- El mismo pipeline y las mismas clases que usa la aplicación web. -->
    <Compile Include="../../../Services/Categorias/EntrenadorCategorias.cs" Link="EntrenadorCategorias.cs" />
  </ItemGroup>

</Project>
