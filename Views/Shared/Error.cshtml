@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container seccion">
    <div class="vacio">
        <span class="vacio__icono">@Iconos.Svg("info", 26)</span>
        <h1 class="vacio__titulo">Algo salió mal</h1>
        <p>Ocurrió un error al procesar tu solicitud. Intenta nuevamente en unos minutos.</p>
        @if (Model.ShowRequestId)
        {
            <p><small>Código de solicitud: <code>@Model.RequestId</code></small></p>
        }
        <a class="btn btn-av-primary" asp-controller="Home" asp-action="Index">Ir al inicio</a>
    </div>
</div>
