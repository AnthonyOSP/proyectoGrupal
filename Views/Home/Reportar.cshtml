@model ReporteFormViewModel
@{
    ViewData["Title"] = "Reportar incidencia";
    var categorias = (List<CategoriaViewModel>)ViewBag.Categorias;
    var reporteEnviado = TempData["ReporteEnviado"] as string;
}

<section class="page-head">
    <div class="container">
        <h1 class="page-head__titulo">Reportar incidencia</h1>
        <p class="page-head__sub">Cuéntanos qué problema viste en el distrito. Los campos marcados con <span class="campo__requerido" aria-hidden="true">*</span> son obligatorios.</p>
    </div>
</section>

<div class="container">
    <div class="form-layout">
        <div>
            @if (reporteEnviado != null)
            {
                <div class="alerta-exito" role="status" tabindex="-1" id="alertaExito">
                    <span class="alerta-exito__icono">@Iconos.Svg("check", 22)</span>
                    <div>
                        <h2 class="alerta-exito__titulo">¡Gracias! Recibimos tu reporte</h2>
                        <p>“@reporteEnviado” será registrado para su revisión.</p>
                        <div class="alerta-exito__acciones">
                            <a class="link-flecha" asp-action="Incidencias">Ver incidencias @Iconos.Svg("arrow-right", 16)</a>
                        </div>
                    </div>
                </div>
            }

            <form class="form-card" asp-action="Reportar" method="post" enctype="multipart/form-data" novalidate id="formReporte">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="resumen-errores" role="alert" tabindex="-1" id="resumenErrores">
                        <strong>Revisa los campos marcados en rojo antes de enviar.</strong>
                    </div>
                }

                <fieldset class="form-grupo">
                    <legend class="form-grupo__titulo"><span class="form-grupo__num">1</span> ¿Qué ocurre?</legend>

                    <div class="campo">
                        <label class="campo__label" asp-for="Titulo">Título de la incidencia<span class="campo__requerido" aria-hidden="true">*</span></label>
                        <input class="form-control" asp-for="Titulo" placeholder="Ej. Poste de alumbrado sin funcionar"
                               autocomplete="off" maxlength="80" aria-describedby="Titulo-ayuda" />
                        <span asp-validation-for="Titulo"></span>
                        <div class="campo__ayuda" id="Titulo-ayuda"><span>Un título corto y claro.</span></div>
                    </div>

                    <div class="campo">
                        <label class="campo__label" asp-for="Categoria">Categoría<span class="campo__requerido" aria-hidden="true">*</span></label>
                        <select class="form-select" asp-for="Categoria">
                            <option value="">Selecciona una categoría</option>
                            @foreach (var categoria in categorias)
                            {
                                <option value="@categoria.Slug">@categoria.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="Categoria"></span>
                    </div>

                    <div class="campo">
                        <label class="campo__label" asp-for="Descripcion">Descripción<span class="campo__requerido" aria-hidden="true">*</span></label>
                        <textarea class="form-control" asp-for="Descripcion" rows="5" maxlength="500"
                                  placeholder="Describe lo que ocurre y proporciona cualquier detalle que pueda ayudar..."
                                  aria-describedby="Descripcion-ayuda" data-contador="Descripcion-contador"></textarea>
                        <span asp-validation-for="Descripcion"></span>
                        <div class="campo__ayuda" id="Descripcion-ayuda">
                            <span>¿Desde cuándo pasa? ¿A quién afecta?</span>
                            <span id="Descripcion-contador" aria-live="polite">@(Model.Descripcion?.Length ?? 0)/500</span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="form-grupo">
                    <legend class="form-grupo__titulo"><span class="form-grupo__num">2</span> ¿Dónde está?</legend>

                    <div class="campo">
                        <label class="campo__label" asp-for="Ubicacion">Ubicación<span class="campo__requerido" aria-hidden="true">*</span></label>
                        <input class="form-control" asp-for="Ubicacion" placeholder="Ej. Av. Próceres con Jr. Lima"
                               autocomplete="street-address" maxlength="120" aria-describedby="Ubicacion-ayuda" />
                        <span asp-validation-for="Ubicacion"></span>
                        <div class="campo__ayuda" id="Ubicacion-ayuda"><span>Dirección, cruce de calles o una referencia cercana.</span></div>
                    </div>
                </fieldset>

                <fieldset class="form-grupo">
                    <legend class="form-grupo__titulo"><span class="form-grupo__num">3</span> Fotografía <span class="campo__opcional">(opcional)</span></legend>

                    <div class="campo">
                        <label class="foto-drop" id="fotoDrop">
                            <input type="file" asp-for="Foto" accept="image/*" aria-describedby="Foto-ayuda" />
                            <span class="foto-drop__icono">@Iconos.Svg("camera", 24)</span>
                            <span class="foto-drop__titulo"><span>Elige una foto</span> o arrástrala aquí</span>
                            <span class="foto-drop__ayuda" id="Foto-ayuda">JPG o PNG, hasta 5 MB. En el celular puedes tomarla con la cámara.</span>
                        </label>

                        <div class="foto-preview" id="fotoPreview" hidden>
                            <img src="" alt="Vista previa de la foto seleccionada" id="fotoPreviewImg" />
                            <div class="foto-preview__info">
                                <span class="foto-preview__nombre" id="fotoPreviewNombre"></span>
                                <span class="foto-preview__peso" id="fotoPreviewPeso"></span>
                            </div>
                            <button type="button" class="btn btn-av-ghost" id="fotoQuitar">
                                @Iconos.Svg("x", 18) Quitar
                            </button>
                        </div>
                        <span class="field-validation-valid" id="fotoError" role="alert"></span>
                    </div>
                </fieldset>

                <div class="form-acciones">
                    <button type="submit" class="btn btn-av-primary btn-lg-av" id="btnEnviar">
                        @Iconos.Svg("send", 18)
                        <span class="spinner" aria-hidden="true"></span>
                        <span class="btn-texto">Enviar reporte</span>
                    </button>
                    <p class="form-acciones__nota">@Iconos.Svg("info", 18) Tu reporte será registrado para su revisión.</p>
                </div>
            </form>
        </div>

        <aside class="form-aside" aria-labelledby="titulo-consejos">
            <div class="aside-card">
                <h2 class="aside-card__titulo" id="titulo-consejos">@Iconos.Svg("info", 20) Consejos para un buen reporte</h2>
                <ul class="lista-check">
                    <li>@Iconos.Svg("check", 18) <span>Usa un título que describa el problema en pocas palabras.</span></li>
                    <li>@Iconos.Svg("check", 18) <span>Indica una referencia fácil de ubicar: un parque, un colegio o un cruce.</span></li>
                    <li>@Iconos.Svg("check", 18) <span>Una foto ayuda mucho a entender la gravedad.</span></li>
                    <li>@Iconos.Svg("check", 18) <span>No incluyas datos personales de otras personas.</span></li>
                </ul>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/reportar.js" asp-append-version="true"></script>
}
