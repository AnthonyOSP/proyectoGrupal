@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";

    // Aviso cuando el visitante llegó aquí al intentar reportar una incidencia.
    var vieneDeReportar = Model.ReturnUrl?.StartsWith("/Home/Reportar", StringComparison.OrdinalIgnoreCase) == true;
}

<div class="av-login" data-av-login>

    @* ===== Escena: mapa del distrito con incidencias de ejemplo (decorativa) ===== *@
    <section class="av-escena" aria-label="Alerta Vecinal">
        <svg class="av-mapa" viewBox="0 0 800 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            <rect width="800" height="900" fill="#0b1220" />
            <!-- Manzanas -->
            <g fill="#111b33">
                <rect x="20" y="20" width="150" height="120" rx="10" /><rect x="200" y="20" width="170" height="120" rx="10" /><rect x="400" y="20" width="120" height="120" rx="10" /><rect x="550" y="20" width="230" height="120" rx="10" />
                <rect x="20" y="170" width="150" height="150" rx="10" /><rect x="200" y="170" width="170" height="150" rx="10" /><rect x="550" y="170" width="110" height="150" rx="10" /><rect x="690" y="170" width="90" height="150" rx="10" />
                <rect x="20" y="350" width="150" height="130" rx="10" /><rect x="400" y="350" width="120" height="130" rx="10" /><rect x="550" y="350" width="230" height="130" rx="10" />
                <rect x="20" y="510" width="150" height="170" rx="10" /><rect x="200" y="510" width="170" height="80" rx="10" /><rect x="200" y="620" width="170" height="60" rx="10" /><rect x="400" y="510" width="120" height="170" rx="10" /><rect x="690" y="510" width="90" height="170" rx="10" />
                <rect x="20" y="710" width="150" height="170" rx="10" /><rect x="200" y="710" width="320" height="170" rx="10" /><rect x="550" y="710" width="230" height="170" rx="10" />
            </g>
            <!-- Parques -->
            <g fill="#0f2a26">
                <rect x="400" y="170" width="120" height="150" rx="10" />
                <rect x="200" y="350" width="170" height="130" rx="10" />
                <rect x="550" y="510" width="110" height="170" rx="10" />
            </g>
            <g fill="#134e3a" opacity=".7">
                <circle cx="245" cy="395" r="16" /><circle cx="300" cy="430" r="20" /><circle cx="335" cy="385" r="12" />
                <circle cx="440" cy="215" r="14" /><circle cx="485" cy="270" r="18" />
                <circle cx="590" cy="560" r="15" /><circle cx="625" cy="630" r="19" />
            </g>
            <!-- Avenidas -->
            <g stroke="#1b2a4d" stroke-width="10" stroke-linecap="round">
                <path d="M0 335 H800" />
                <path d="M535 0 V900" />
                <path d="M-40 840 L840 600" stroke-width="14" />
            </g>
            <g stroke="#2b3d66" stroke-width="2" stroke-dasharray="8 10">
                <path d="M0 335 H800" />
                <path d="M535 0 V900" />
            </g>
            <!-- Ruta del equipo de atención -->
            <path class="av-ruta" d="M185 155 H385 V335 H535 V495 H675 V695" fill="none" stroke="#3b82f6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity=".55" />
        </svg>

        @* Pines: los tres primeros se resaltan junto con su fila del panel de actividad (auth-login.js). *@
        <div aria-hidden="true">
            <div class="av-pin es-activo" data-av-item="0" style="left: 70%; top: 19%">
                <span class="av-pin__onda"></span><span class="av-pin__onda av-pin__onda--2"></span><span class="av-pin__punto"></span>
                <span class="av-pin__etiqueta">Poste sin luz</span>
            </div>
            <div class="av-pin" data-av-item="1" style="left: 84%; top: 55%">
                <span class="av-pin__onda"></span><span class="av-pin__onda av-pin__onda--2"></span><span class="av-pin__punto"></span>
                <span class="av-pin__etiqueta">Bache en la pista</span>
            </div>
            <div class="av-pin" data-av-item="2" style="left: 63%; top: 40%">
                <span class="av-pin__onda"></span><span class="av-pin__onda av-pin__onda--2"></span><span class="av-pin__punto"></span>
                <span class="av-pin__etiqueta">Árbol caído</span>
            </div>
            <div class="av-pin av-pin--chico" style="left: 90%; top: 30%"><span class="av-pin__onda"></span><span class="av-pin__punto"></span></div>
            <div class="av-pin av-pin--chico" style="left: 76%; top: 74%"><span class="av-pin__onda av-pin__onda--2"></span><span class="av-pin__punto"></span></div>
            <div class="av-pin av-pin--chico" style="left: 55%; top: 86%"><span class="av-pin__onda"></span><span class="av-pin__punto"></span></div>
        </div>

        <div class="av-escena__velo"></div>

        <div class="av-escena__contenido">
            <a class="av-marca av-entra" asp-controller="Home" asp-action="Index" aria-label="Alerta Vecinal, ir al inicio">
                <span class="av-marca__icono" aria-hidden="true">@Iconos.Svg("megaphone", 24)</span>
                <span class="av-marca__texto">Alerta<span>Vecinal</span></span>
            </a>

            <div>
                <span class="av-vivo av-entra" style="animation-delay: .1s"><span class="av-punto-vivo" aria-hidden="true"></span>Tu distrito: La Molina</span>
                <h2 class="av-titular av-entra" style="animation-delay: .2s">Reporta lo que ves.<span>Sigue cómo se resuelve.</span></h2>
                <p class="av-sub av-entra" style="animation-delay: .35s">Postes sin luz, baches, fugas de agua: cada reporte llega al equipo del distrito y puedes seguir su estado en tiempo real.</p>
            </div>

            @* Reportes de ejemplo que muestran el ciclo de una incidencia. Decorativo: se oculta a lectores de pantalla. *@
            <div class="av-feed av-entra" style="animation-delay: .5s" aria-hidden="true">
                <div class="av-feed__cabecera">
                    <span>Así funciona un reporte</span>
                    <span class="av-feed__vivo"><span class="av-punto-vivo"></span>Ejemplo</span>
                </div>
                <div class="av-feed__lista">
                    <div class="av-fila es-activo" data-av-item="0">
                        <span class="av-fila__icono">@Iconos.Svg("lightbulb", 20)</span>
                        <span class="av-fila__texto"><span class="av-fila__titulo">Poste sin luz</span><span class="av-fila__lugar">Av. La Molina, cuadra 12</span></span>
                        <span class="av-estado estado--pendiente">@Iconos.Svg("clock", 13) Pendiente</span>
                    </div>
                    <div class="av-fila" data-av-item="1">
                        <span class="av-fila__icono">@Iconos.Svg("road", 20)</span>
                        <span class="av-fila__texto"><span class="av-fila__titulo">Bache en la pista</span><span class="av-fila__lugar">Calle Los Fresnos</span></span>
                        <span class="av-estado estado--revision">@Iconos.Svg("search", 13) En revisión</span>
                    </div>
                    <div class="av-fila" data-av-item="2">
                        <span class="av-fila__icono">@Iconos.Svg("tree", 20)</span>
                        <span class="av-fila__texto"><span class="av-fila__titulo">Árbol caído</span><span class="av-fila__lugar">Parque Los Sauces</span></span>
                        <span class="av-estado estado--atendida">@Iconos.Svg("check-circle", 13) Atendida</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ===== Formulario ===== *@
    <main class="av-panel" id="contenido" tabindex="-1">
        <div class="av-panel__arriba">
            <a class="av-volver" asp-controller="Home" asp-action="Index">@Iconos.Svg("arrow-left", 18) Volver al inicio</a>
        </div>

        <div class="av-form-caja">
            <div class="av-entra" style="animation-delay: .15s">
                <span class="av-saludo">@Iconos.Svg("map-pin", 16) Bienvenido de vuelta</span>
                <h1 class="av-form-titulo">Inicia sesión</h1>
                <p class="av-form-sub">Ingresa con tu cuenta para reportar incidencias en tu distrito.</p>
            </div>

            @if (vieneDeReportar)
            {
                <p class="auth-aviso av-aviso av-entra" role="note" style="animation-delay: .2s">
                    @Iconos.Svg("info", 18)
                    <span>Para reportar una incidencia necesitas iniciar sesión. Te llevaremos al formulario al entrar.</span>
                </p>
            }

            <form asp-action="Login" method="post" novalidate class="av-form" data-av-form>
                <div asp-validation-summary="ModelOnly" class="resumen-errores" role="alert"></div>

                <input type="hidden" asp-for="ReturnUrl" />

                <div class="av-campo av-entra" style="animation-delay: .25s">
                    <label class="av-label" asp-for="Email">Correo electrónico</label>
                    <div class="av-input-caja">
                        @Iconos.Svg("mail", 20)
                        <input class="av-input" asp-for="Email" type="email" autocomplete="username"
                               placeholder="tucorreo@ejemplo.com" maxlength="256" autofocus />
                    </div>
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="av-campo av-entra" style="animation-delay: .33s">
                    <label class="av-label" asp-for="Password">Contraseña</label>
                    <div class="av-input-caja">
                        @Iconos.Svg("lock", 20)
                        <input class="av-input av-input--clave" asp-for="Password" autocomplete="current-password"
                               placeholder="Tu contraseña" maxlength="100" />
                        @* Solo con JavaScript (auth-login.js lo muestra). *@
                        <button type="button" class="av-ojo" data-av-ojo aria-controls="Password" aria-pressed="false" aria-label="Mostrar contraseña" hidden>
                            <span data-av-ojo-mostrar>@Iconos.Svg("eye", 20)</span>
                            <span data-av-ojo-ocultar hidden>@Iconos.Svg("eye-off", 20)</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>

                <label class="av-check av-entra" style="animation-delay: .4s">
                    <input asp-for="RememberMe" />
                    Recordarme en este dispositivo
                </label>

                <div class="av-entra" style="animation-delay: .48s">
                    <button type="submit" class="av-boton" data-av-enviar>
                        <span class="av-boton__normal">Iniciar sesión @Iconos.Svg("arrow-right", 20, "av-flecha")</span>
                        <span class="av-boton__cargando" hidden><span class="av-giro" aria-hidden="true"></span> Ingresando…</span>
                    </button>
                </div>
            </form>

            <div class="av-registro av-entra" style="animation-delay: .56s">
                <div class="av-separador">¿Todavía no tienes cuenta?</div>
                <a class="av-boton-sec" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@Iconos.Svg("user", 20) Crear una cuenta</a>
            </div>

            <p class="av-privacidad av-entra" style="animation-delay: .64s">
                @Iconos.Svg("shield", 18)
                Tu privacidad importa: pixelamos los rostros de las fotos antes de guardarlas.
            </p>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth-login.js" asp-append-version="true"></script>
}
