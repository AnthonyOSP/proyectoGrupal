<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programa de consola que entrena el modelo de análisis de sentimientos.
       Se ejecuta a mano cuando cambian los datos de entrenamiento (ver README.md de esta carpeta).
       No es parte de la aplicación web: proyectoGrupal.csproj excluye la carpeta ML/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las mismas clases de entrada/salida que usa la aplicación web al consumir el modelo. -->
    <Compile Include="../../../Services/Sentimiento/SentimientoModelos.cs" Link="SentimientoModelos.cs" />
    <Compile Include="../../../Services/Sentimiento/EntrenadorSentimiento.cs" Link="EntrenadorSentimiento.cs" />
  </ItemGroup>

</Project>
