@model IncidenciaViewModel
@{
    ViewData["Title"] = $"Incidencia #{Model.Id}";

    var mensaje = TempData["MensajeAdmin"] as string;
    var errorEstado = ViewData.ModelState["estado"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var errorEliminar = ViewData.ModelState["eliminar"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<nav class="migas" aria-label="Ruta de navegación">
    <ol>
        <li><a asp-action="Index">Dashboard</a></li>
        <li><a asp-action="Incidencias">Incidencias</a></li>
        <li aria-current="page">#@Model.Id</li>
    </ol>
</nav>

<header class="admin-cabecera">
    <div>
        <div class="detalle-cabecera__chips">
            <span class="admin-id admin-id--grande">#@Model.Id</span>
            <span class="chip-cat" data-cat="@Model.Categoria.Slug">@Iconos.Svg(Model.Categoria.Icono, 14) @Model.Categoria.Nombre</span>
            <partial name="_EstadoBadge" model="Model.Estado" />
        </div>
        <h1 class="admin-cabecera__titulo">@Model.Titulo</h1>
        <p class="admin-cabecera__sub">Reportada el @Model.FechaTexto a las @Model.Fecha.ToString("HH:mm")</p>
    </div>
    <div class="seguimiento-acciones seguimiento-acciones--admin">
        <a class="btn btn-av-secondary" asp-action="Seguimiento" asp-route-id="@Model.Id">
            @Iconos.Svg("clock", 18) Ver seguimiento
        </a>
        <a class="btn btn-av-secondary" asp-controller="Home" asp-action="Detalle" asp-route-id="@Model.Id" target="_blank" rel="noopener">
            @Iconos.Svg("external", 18) Ver en el sitio público
        </a>
    </div>
</header>

@if (mensaje != null)
{
    <div class="alerta-exito" role="status" tabindex="-1" id="mensajeAdmin">
        <span class="alerta-exito__icono">@Iconos.Svg("check", 22)</span>
        <div>
            <p class="alerta-exito__titulo mb-0">@mensaje</p>
        </div>
    </div>
}

<div class="detalle-layout detalle-layout--admin">
    <div>
        @if (Model.FotoSegura != null)
        {
            <figure class="detalle-foto">
                <img src="@Model.FotoSegura" alt="Fotografía de la incidencia: @Model.Titulo" />
                <figcaption>@Iconos.Svg("shield", 16) Foto protegida: los rostros detectados se pixelaron antes de guardarla.</figcaption>
            </figure>
        }

        <section class="bloque" aria-labelledby="titulo-descripcion">
            <h2 class="bloque__titulo" id="titulo-descripcion">Descripción</h2>
            <p class="bloque__texto">@Model.Descripcion</p>
        </section>

        <section class="bloque" aria-labelledby="titulo-datos">
            <h2 class="bloque__titulo" id="titulo-datos">Datos del reporte</h2>
            <dl class="datos">
                <div>
                    <span class="datos__icono" aria-hidden="true">@Iconos.Svg("list", 20)</span>
                    <div><dt>ID</dt><dd>#@Model.Id</dd></div>
                </div>
                <div>
                    <span class="datos__icono" aria-hidden="true">@Iconos.Svg("map-pin", 20)</span>
                    <div><dt>Ubicación</dt><dd>@Model.Ubicacion</dd></div>
                </div>
                <div>
                    <span class="datos__icono" aria-hidden="true">@Iconos.Svg("calendar", 20)</span>
                    <div><dt>Fecha de registro</dt><dd>@Model.FechaTexto, @Model.Fecha.ToString("HH:mm")</dd></div>
                </div>
                <div>
                    <span class="datos__icono" aria-hidden="true">@Iconos.Svg(Model.Categoria.Icono, 20)</span>
                    <div><dt>Categoría</dt><dd>@Model.Categoria.Nombre</dd></div>
                </div>
            </dl>
        </section>

        <partial name="_MapaIncidencia" model="Model" />
    </div>

    <aside>
        <section class="bloque cambiar-estado" id="cambiar-estado" aria-labelledby="titulo-cambiar-estado">
            <h2 class="bloque__titulo" id="titulo-cambiar-estado">Cambiar estado</h2>
            <p class="cambiar-estado__actual">Estado actual: <partial name="_EstadoBadge" model="Model.Estado" /></p>

            @* Un botón por estado: cada uno envía el id (en la URL) y su estado. Los demás datos no se pueden modificar. *@
            <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" id="formEstado">
                <fieldset class="estado-botones" aria-describedby="@(errorEstado != null ? "estado-error" : null)">
                    <legend class="campo__label">Nuevo estado</legend>
                    @foreach (var estado in Enum.GetValues<EstadoIncidencia>())
                    {
                        var esActual = estado == Model.Estado;
                        <button type="submit" name="estado" value="@estado.Texto()"
                                class="btn estado-boton @estado.ClaseCss()" disabled="@esActual" aria-pressed="@(esActual ? "true" : "false")">
                            @Iconos.Svg(estado.Icono(), 18) <span class="btn-texto">@estado.Texto()</span>
                            @if (esActual)
                            {
                                <span class="estado-boton__actual">Actual</span>
                            }
                        </button>
                    }
                    @if (errorEstado != null)
                    {
                        <span class="field-validation-error" id="estado-error" role="alert">@errorEstado</span>
                    }
                </fieldset>
            </form>
            <p class="cambiar-estado__nota">@Iconos.Svg("info", 16) Solo se modifica el estado. Los datos reportados por el vecino no cambian.</p>

            @* Eliminar: formulario aparte, con confirmación antes de enviar. *@
            <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" id="formEliminar" class="eliminar-incidencia">
                <button type="submit" class="btn btn-av-danger w-100" id="btnEliminar">
                    @Iconos.Svg("trash", 18) <span class="btn-texto">Eliminar incidencia</span>
                </button>
                @if (errorEliminar != null)
                {
                    <span class="field-validation-error" role="alert">@errorEliminar</span>
                }
            </form>
        </section>
    </aside>
</div>

@section Scripts {
    @if (Model.TieneUbicacion)
    {
        <partial name="_GoogleMaps" />
    }
    <script>
        // Anuncia el mensaje de confirmación a los lectores de pantalla.
        document.getElementById("mensajeAdmin")?.focus();

        // Evita envíos dobles mientras se guarda. Los botones se desactivan después de que el navegador
        // tomó el valor del botón pulsado (un botón desactivado no envía su valor).
        document.getElementById("formEstado").addEventListener("submit", evento => {
            const pulsado = evento.submitter;
            setTimeout(() => {
                evento.target.querySelectorAll("button").forEach(b => b.disabled = true);
                if (pulsado) {
                    pulsado.querySelector(".btn-texto").textContent = "Guardando...";
                }
            });
        });

        // Eliminar no se puede deshacer: se pide confirmación.
        document.getElementById("formEliminar").addEventListener("submit", evento => {
            if (!confirm("¿Eliminar la incidencia #@Model.Id? Se borrarán también su foto y su historial. Esta acción no se puede deshacer.")) {
                evento.preventDefault();
                return;
            }
            const boton = document.getElementById("btnEliminar");
            setTimeout(() => {
                boton.disabled = true;
                boton.querySelector(".btn-texto").textContent = "Eliminando...";
            });
        });
    </script>
}
